# Production environment template. Copy to .env.production (git-ignored) and
# replace every placeholder. Never reuse staging secrets, domain, database,
# volumes or credentials here.
COMPOSE_PROJECT_NAME=gym-production
DOMAIN=gym.example.com
ACME_EMAIL=ops@example.com
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

POSTGRES_PASSWORD=replace-with-a-unique-production-database-password
SECRET_KEY=replace-with-a-unique-32-plus-character-production-secret
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-unique-production-admin-password
BACKEND_IMAGE=gym-app-production:latest

WEB_CONCURRENCY=1
HSTS_ENABLED=true
LOG_JSON=true
SENTRY_ENVIRONMENT=production
SENTRY_DSN=

SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@gym.example.com
EMAILS_FROM_NAME=ASCORA
# Must stay empty in production; production rejects redirection at startup.
EMAIL_REDIRECT_TO=
