# Staging environment template. Copy to .env.staging (git-ignored) and replace
# every placeholder. Never reuse production secrets, domain, database, volumes
# or credentials here.
COMPOSE_PROJECT_NAME=gym-staging
DOMAIN=staging.gym.example.com
ACME_EMAIL=ops@example.com
# Let's Encrypt staging CA: untrusted certificates, safe for repeated testing.
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

POSTGRES_PASSWORD=replace-with-a-unique-staging-database-password
SECRET_KEY=replace-with-a-unique-32-plus-character-staging-secret
FIRST_SUPERUSER=staging-admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-unique-staging-admin-password
BACKEND_IMAGE=gym-app-staging:latest

WEB_CONCURRENCY=1
HSTS_ENABLED=false
LOG_JSON=true
SENTRY_ENVIRONMENT=staging
SENTRY_DSN=

SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=Gym Management Staging
# Required when SMTP is configured: staging must never email real addresses.
EMAIL_REDIRECT_TO=staging-inbox@example.com
