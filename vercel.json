{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "installCommand": "npm install -g bun@1.3.14 && bun install --frozen-lockfile && .vercel/python/.venv/bin/python -m pip install -r requirements.txt",
  "regions": ["cle1"],
  "functions": {
    "server.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,frontend/**,backend/tests/**,backend/coverage/**,backend/htmlcov/**,docs/**,.git/**,playwright-report/**,test-results/**,backend/uploads/**,.venv/**,**/__pycache__/**,**/*.pyc,**/*.md,package.json,bun.lock,uv.lock,neon.ts,.env*,**/.env*}"
    }
  }
}
