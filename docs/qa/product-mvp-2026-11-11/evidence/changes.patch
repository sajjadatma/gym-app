+def draft(client: TestClient, env: dict[str, Any], request_id: str) -> Any:
+    return client.post(
+        f"/api/v1/athletes/{env['athlete_id']}/programs",
+        headers=env["coach"],
+        json={"title": "Purchased program", "purchase_request_id": request_id},
+    )
