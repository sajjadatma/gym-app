# Copy to .env and set real local values. Never commit .env.
FASTAPI_ENV=development
PROJECT_NAME="Gym Management"
SECRET_KEY=replace-with-a-long-random-value
FRONTEND_HOST=http://localhost:5173

FIRST_SUPERUSER=sajjadnaserizadeh@gmail.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-private-local-password

# Local PostgreSQL. The database is created by scripts/bootstrap_local.sh.
DATABASE_URL=postgresql://YOUR_LOCAL_USER@localhost:5432/gym_app
TEST_DATABASE_URL=postgresql://YOUR_LOCAL_USER@localhost:5432/gym_app_test

# Local Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=False
EMAILS_FROM_EMAIL=no-reply@gymapp.example.com
EMAILS_FROM_NAME="Gym Management"

BODY_ANALYSIS_MAX_BYTES=10485760
