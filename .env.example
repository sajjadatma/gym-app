# Copy to .env and set real local values. Never commit .env.
PROJECT_NAME="Gym Management"
SECRET_KEY=replace-with-a-long-random-value
FRONTEND_HOST=http://localhost:5173

FIRST_SUPERUSER=sajjadnaserizadeh@gmail.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-private-local-password

# Local PostgreSQL. The database is created by scripts/bootstrap_local.sh.
DATABASE_URL=postgresql://YOUR_LOCAL_USER@localhost:5432/gym_app
TEST_DATABASE_URL=postgresql://YOUR_LOCAL_USER@localhost:5432/gym_app_test

# Local Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=False
EMAILS_FROM_EMAIL=no-reply@gymapp.example.com
EMAILS_FROM_NAME="Gym Management"

BODY_ANALYSIS_MAX_BYTES=10485760
# Optional Neon Object Storage (S3-compatible) for body-analysis files.
# Leave BODY_ANALYSIS_BUCKET empty to use BODY_ANALYSIS_DIR on local disk.
BODY_ANALYSIS_BUCKET=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Browser session and production hardening
FASTAPI_ENV=development
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
HSTS_ENABLED=False
CSP_CONNECT_SRC='self'
ACCESS_TOKEN_EXPIRE_MINUTES=720
MAX_JSON_BODY_BYTES=1048576
RATE_LIMIT_ENABLED=True
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=900
LOGIN_IP_RATE_LIMIT=50
RECOVERY_RATE_LIMIT=5
RECOVERY_RATE_WINDOW_SECONDS=3600
RECOVERY_IP_RATE_LIMIT=30
TRUST_PROXY_HEADERS=False
LOG_JSON=False
SENTRY_ENVIRONMENT=
EMAIL_REDIRECT_TO=
